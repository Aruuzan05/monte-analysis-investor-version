# Copy to secrets.toml (never commit it). On Streamlit Community Cloud paste
# the same content under Manage app -> Settings -> Secrets.

[database]
# Where accounts and saved runs are stored.
#  * Leave this out to use a local SQLite file (data/keepp.db). Fine on your
#    laptop or the Docker server, but NOT on Community Cloud: its disk is
#    wiped on every reboot and redeploy, and all saved runs would go with it.
#  * On Community Cloud, use a hosted Postgres database (e.g. a free Neon or
#    Supabase project) and paste its connection string here:
url = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

[auth]
# Invitation code people must type to create an account. Without one, only
# the very first account can be created in the app; add the rest with
#   python manage_users.py add <username>
signup_code = "change-me-to-something-long"
