# ---------------------------------------------------------------------------
# SECRETS — never commit these.
# On Streamlit Community Cloud the app password goes in the app dashboard
# (Manage app -> Settings -> Secrets), NOT in a file in the repo.
# ---------------------------------------------------------------------------
.streamlit/secrets.toml
*.env
.env
.env.*
!.env.example

